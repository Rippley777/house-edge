# Local development needs no credentials. A labeled demo is seeded automatically.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=.data/house-edge.db
DEMO_MODE=true

# Set DATABASE_PROVIDER=azure and DEMO_MODE=false for production.
# Use a least-privilege SQL account; migrations need separate DDL credentials.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=house-edge
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
# Alternatively: AZURE_SQL_AUTH=managed-identity (Azure App Service identity)
AZURE_SQL_AUTH=password
AZURE_SQL_CLIENT_ID=

# Required in production; generate each with: openssl rand -hex 32
ADMIN_KEY=
SESSION_SECRET=
PUBLIC_URL=http://localhost:3000
DATA_RETENTION_DAYS=90
# The collector has database-backed per-project limits, shared across instances.
INGESTION_EVENTS_PER_MINUTE=6000
# Used only by the maintenance command's optional webhook notification provider.
ALERT_WEBHOOK_URL=
