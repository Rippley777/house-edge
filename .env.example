# Local development needs no credentials. A labeled demo is seeded automatically.
DATABASE_PROVIDER=sqlite
SQLITE_PATH=.data/house-edge.db
DEMO_MODE=true

# Set DATABASE_PROVIDER=azure and DEMO_MODE=false for production.
# Use a least-privilege SQL account; migrations need separate DDL credentials.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=house-edge
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
# Alternatively: AZURE_SQL_AUTH=managed-identity (Azure App Service identity)
AZURE_SQL_AUTH=password
AZURE_SQL_CLIENT_ID=

# Required in production; generate each with: openssl rand -hex 32
ADMIN_KEY=
SESSION_SECRET=
PUBLIC_URL=http://localhost:3000
DATA_RETENTION_DAYS=90
# The collector has database-backed per-project limits, shared across instances.
INGESTION_EVENTS_PER_MINUTE=6000
# Used only by the maintenance command's optional webhook notification provider.
ALERT_WEBHOOK_URL=

# Event Geography: no external provider or paid service required by default.
# Legacy LOGIN_GEOGRAPHY_ENABLED is still honored when GEOGRAPHY_ENABLED is unset.
GEOGRAPHY_ENABLED=true
# All event types and environments are eligible; set true to limit enrichment to production.
GEO_PRODUCTION_ONLY=false
GEO_RETENTION_DAYS=30
# Dedicated server secrets, never NEXT_PUBLIC. Generate separately with openssl rand -hex 32.
# Without a queue key, IP enrichment stays unknown; trusted country fallback still works.
GEO_QUEUE_KEY=
GEO_IP_HASH_SALT=
# Optional local GeoLite-compatible MMDB, mounted read-only. Refresh the database/version regularly.
GEO_MMDB_PATH=
GEO_PROVIDER_VERSION=1
# Optional HTTPS POST adapter accepting {"ip":"..."}; see docs/login-geography.md for response contract.
GEO_PROVIDER_URL=
GEO_PROVIDER_TOKEN=
GEO_TIMEOUT_MS=1500
GEO_LOOKUP_INTERVAL_MS=0
# Set false for quota-limited providers and drain jobs with a single scheduled worker.
GEO_AFTER_RESPONSE_ENABLED=true
GEO_CACHE_DAYS=7
# Only used with a socket-aware collector host. List trusted proxy networks, never all addresses.
GEO_TRUSTED_PROXY_CIDRS=
GEO_CLOUDFLARE_CIDRS=
# Next.js has no socket peer: ingress must strip/replace this token header and forwarded headers.
GEO_INGRESS_SECRET=
# Only true when the authenticated ingress restricts requests to Cloudflare and preserves its headers.
GEO_CLOUDFLARE_INGRESS=false
# Development-only sample endpoint: requires demo mode and a non-production Node environment.
GEO_DEVELOPMENT_SAMPLES=false
# Public map styles; map requests disclose viewer IP/viewport to the tile host, never event IPs.
NEXT_PUBLIC_GEO_MAP_DARK_STYLE=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_GEO_MAP_LIGHT_STYLE=https://tiles.openfreemap.org/styles/positron
